<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Lunmi</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>ja</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>NSCameraUsageDescription</key>
	<string>Use your camera to take a profile photo, share media, or join a video call.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Use your microphone when you speak in a Voice Room, record audio, or join a call.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Choose photos or videos to share on Lunmi or use as your profile photo.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Save a photo or video to your library when you choose to save it.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Allow location access when you choose a location-related feature.</string>
	<key>NSContactsUsageDescription</key>
	<string>Access contacts only when you choose to use a contacts feature.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID when you choose to verify your identity on this device.</string>
	<key>UIRequiresFullScreen</key>
	<true/>
</dict>
</plist>
